# Nilai default untuk development lokal, dibaca otomatis oleh Makefile.
# Untuk mengubahnya, salin ke .env (tidak ikut di-commit) lalu edit di sana:
#   cp .env.example .env
KELANA_HTTP_ADDR=:8080
KELANA_DATABASE_URL=postgres://kelana:kelana@localhost:5432/kelana?sslmode=disable
KELANA_LOG_LEVEL=debug
KELANA_LOG_FORMAT=text
KELANA_SHUTDOWN_TIMEOUT=10s
